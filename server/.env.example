# Copy to .env and fill in real values.

# MySQL connection string. Format:
# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/cag_wms"

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Only email addresses on this domain may register.
ALLOWED_EMAIL_DOMAIN="cag.gov.in"

# Server
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Where uploaded attachments are stored (MVP: local disk)
UPLOAD_DIR="./uploads"

# ---- Organization branding ----
ORG_NAME="CAG Work Management"

# ---- Email (optional) ----
# Leave SMTP_HOST blank to run without a mail server (emails are logged only).
# Set EMAIL_ON_NOTIFY=true to actually send an email for each notification.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@cag.local"
EMAIL_ON_NOTIFY=false

# ---- Reminders (optional) ----
# When true, a daily job notifies leads of work due within a day or overdue.
ENABLE_REMINDERS=false
