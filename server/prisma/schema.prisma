// CAG Work Management System - Prisma schema (MySQL)
// This models the FULL application. Routes fill in feature by feature on top.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- enums ----------
// Roles, permissions and hierarchy are DATA, not code. An admin can rename,
// add, or remove roles and remap permissions without touching the app.
/// A Role is a bundle of permissions. It is NOT a job title: see Designation.
///
/// officeId NULL means a platform-owned template that the Super Admin maintains.
/// An Office Admin clones a template into their own office and edits it there,
/// so two offices can each have a "Reviewer" meaning different things while
/// templateId still lets you compare them platform-wide.
model Role {
  id          String   @id @default(uuid()) @db.Char(36)
  name        String
  description String?
  level       Int      @default(0) // hierarchy: higher = more senior
  officeId    String?  @db.Char(36)
  office      Office?  @relation(fields: [officeId], references: [id])
  templateId  String?  @db.Char(36)
  template    Role?    @relation("RoleTemplate", fields: [templateId], references: [id])
  clones      Role[]   @relation("RoleTemplate")
  isSystem    Boolean  @default(false) // built-in, protected from deletion
  isDefault   Boolean  @default(false) // auto-assigned to new accounts
  createdAt   DateTime @default(now())

  users       User[]
  permissions RolePermission[]

  @@unique([officeId, name])
  @@index([templateId])
}

/// A Designation is the official post someone holds (DG, SAO, AAO...). It is
/// descriptive only: `rank` orders people for display and reporting and must
/// NEVER be consulted by an authorisation check. Permissions come from Role.
///
/// officeId NULL means a platform-wide designation the Super Admin maintains;
/// an office may add its own on top.
model Designation {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String
  code      String?
  rank      Int      @default(0) // display/report ordering only, never authorisation
  officeId  String?  @db.Char(36)
  office    Office?  @relation(fields: [officeId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users User[]

  @@unique([officeId, name])
  @@index([rank])
}

model Permission {
  id          String           @id @default(uuid()) @db.Char(36)
  key         String           @unique // e.g. "task.view_all"
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String     @db.Char(36)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @db.Char(36)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

enum TaskStatus {
  YET_TO_BE_ASSIGNED
  INITIATED
  IN_PROGRESS
  FINISHED
  ON_HOLD
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// Where a work request is aimed. USER = a person in my own department,
// DEPARTMENT = a person in another department of my office (dept head approves),
// OFFICE = another CAG office entirely (that office's head approves, then
// nominates one of their own staff to carry it out).
enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
}

/// A person's standing inside one project. Replaces the old standing Team.
enum ProjectRole {
  PRIMARY_LEAD
  SECONDARY_LEAD
  MEMBER
  OBSERVER
}

enum RequestScope {
  USER
  DEPARTMENT
  OFFICE
}

enum RequestState {
  PENDING_APPROVAL   // cross-department/cross-office: waiting for the target head
  PENDING_ACCEPTANCE // waiting for the assignee to accept
  ACCEPTED           // assignee accepted; they now own it
  DECLINED           // assignee declined; sent back to assigner
  REJECTED           // department head rejected the incoming work
  CANCELLED          // assigner cancelled
}

enum MeetingMode {
  PHYSICAL
  ONLINE
}

/// What a post on a work item or project actually is. A thread that mixes
/// "here is where we are" with "please do X" with "we are blocked" becomes
/// unreadable within a week, so the kind is recorded rather than inferred.
enum CommentKind {
  REMARK        // ordinary comment / discussion
  STATUS_UPDATE // progress report: carries the status and % it moved to
  DIRECTION     // an instruction from a senior officer
  DECISION      // a decision that was taken, for the record
  BLOCKER       // something is stopping the work
}

// Singleton row (id = "org") holding the tenant's branding. Everything
// organization-specific lives here as data, so the app can be rebranded for a
// different organization without code changes.
model OrgSettings {
  id           String   @id @default("org")
  name         String   @default("CAG Work Management")
  logoPath     String?
  primaryColor String   @default("#0B2447")
  accentColor  String   @default("#C1922B")
  updatedAt    DateTime @updatedAt
}

// ---------- offices ----------
model Office {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String
  code      String?  @unique
  city      String?
  // The office's official mailbox. This doubles as the Office Admin login, and
  // it is the one contact detail other offices are allowed to see.
  email     String?
  // The IAAS-rank officer (DG / PAG / DAG) who answers for this office. They
  // approve or reject work requests that arrive from other offices.
  headId    String?  @db.Char(36)
  head      User?    @relation("OfficeHead", fields: [headId], references: [id])
  isActive  Boolean  @default(true)
  // Offices are archived, never deleted: destroying one would take years of
  // audit trail with it.
  archivedAt DateTime?
  createdAt DateTime @default(now())

  users        User[]
  departments  Department[]
  projects     Project[]
  roles        Role[]
  designations Designation[]
  owningTasks    Task[] @relation("TaskOwningOffice")
  executingTasks Task[] @relation("TaskExecutingOffice")
  incomingRequests TaskRequest[] @relation("ReqOffice")

  @@index([headId])
}

// A department/wing within an office. Can nest (parent) and has a head user.
// This is the org structure the approval engine will route work through.
model Department {
  id          String   @id @default(uuid()) @db.Char(36)
  name        String
  code        String?
  description String?
  officeId    String?  @db.Char(36)
  office      Office?  @relation(fields: [officeId], references: [id])
  parentId    String?  @db.Char(36)
  parent      Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children    Department[] @relation("DeptTree")
  headId      String?  @db.Char(36)
  head        User?    @relation("DeptHead", fields: [headId], references: [id])
  members     User[]   @relation("DeptMembers")
  tasks       Task[]   @relation("TaskDept")
  incomingRequests TaskRequest[] @relation("ReqDept")
  createdAt   DateTime @default(now())

  projects    Project[]    @relation("ProjectDept")

  @@index([officeId])
  @@index([parentId])
}

// ---------- users (auth + profile in one table) ----------
model User {
  id           String   @id @default(uuid()) @db.Char(36)
  // Renamed from cagId: nothing organisation-specific in a column name, so the
  // platform can be rebranded for another department without a migration.
  employeeId   String?  @unique
  fullName     String
  email        String   @unique
  passwordHash String
  mobile       String?
  // The official post held. Descriptive only; permissions come from `role`.
  designationId String? @db.Char(36)
  designation   Designation? @relation(fields: [designationId], references: [id])
  // Service cadre, e.g. "IA&AS", "Group B (SOGE)", "Contract". Free text on
  // purpose: establishment terminology varies between offices.
  cadre        String?
  wing         String?
  roleId       String?  @db.Char(36)
  // Restrict, NOT the Prisma default of SetNull. Deleting a role that people
  // still hold would silently strip their permissions and leave them locked
  // out with no error anywhere. Move people off a role before deleting it.
  role         Role?    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  avatarUrl    String?
  officeId     String?  @db.Char(36)
  office       Office?  @relation(fields: [officeId], references: [id])
  departmentId String?  @db.Char(36)
  department   Department? @relation("DeptMembers", fields: [departmentId], references: [id])
  headedDepartments Department[] @relation("DeptHead")
  managerId    String?  @db.Char(36)
  manager      User?    @relation("UserManager", fields: [managerId], references: [id])
  reports      User[]   @relation("UserManager")
  // Account lifecycle. Logins are minted by a Super Admin (office admins) or by
  // an Office Admin (office staff), never by self sign-up.
  isActive           Boolean  @default(true)
  // Deletion, as far as any user is concerned. A tombstoned account vanishes
  // from every list, search result and picker in the app and can never sign in
  // again, but the rows that point at it (who created this task, who wrote this
  // remark, who approved this request) keep resolving to a real name. Erasing
  // the row instead would punch holes in years of audit trail.
  deletedAt          DateTime?
  mustChangePassword Boolean  @default(false)
  createdById        String?  @db.Char(36)
  createdBy          User?    @relation("UserCreator", fields: [createdById], references: [id])
  createdUsers       User[]   @relation("UserCreator")
  headedOffices      Office[] @relation("OfficeHead")
  projectMemberships ProjectMember[] @relation("ProjectMembership")
  createdProjects    Project[]       @relation("ProjectCreator")
  lastLoginAt        DateTime?
  // Identity provider. "local" today; SSO (NIC / Parichay / AD) later becomes a
  // new provider rather than a rewrite of every session path.
  authProvider       String   @default("local")
  externalId         String?
  createdAt    DateTime @default(now())

  tasksCreated    Task[]                @relation("TaskCreator")
  tasksPrimary    Task[]                @relation("TaskPrimary")
  tasksSecondary  Task[]                @relation("TaskSecondary")
  tasksHolding    Task[]                @relation("TaskHolder")
  requestsFrom    TaskRequest[]         @relation("ReqFrom")
  requestsTo      TaskRequest[]         @relation("ReqTo")
  requestsApproved TaskRequest[]        @relation("ReqApprover")
  comments        TaskComment[]
  projectComments ProjectComment[]
  attachments     Attachment[]
  meetingsCreated Meeting[]             @relation("MeetingCreator")
  meetingParts    MeetingParticipant[]
  notifications   Notification[]
  activities      ActivityLog[]

  @@index([officeId])
  @@index([roleId])
  @@index([departmentId])
  @@index([managerId])
  @@index([createdById])
  @@index([designationId])
  @@index([authProvider, externalId])
}

// ---------- tasks ----------
/// A Project is the container that gathers people and work. There are no
/// standing teams: each project forms its own working group for its own
/// duration, and membership is editable throughout.
model Project {
  id           String        @id @default(uuid()) @db.Char(36)
  name         String
  code         String?
  description  String?       @db.Text
  status       ProjectStatus @default(ACTIVE)
  // Projects carry an urgency of their own, so a dashboard can rank whole
  // programmes, not only the individual items inside them.
  priority     TaskPriority  @default(NORMAL)
  officeId     String        @db.Char(36)
  office       Office        @relation(fields: [officeId], references: [id])
  departmentId String?       @db.Char(36)
  department   Department?   @relation("ProjectDept", fields: [departmentId], references: [id])
  createdById  String?       @db.Char(36)
  createdBy    User?         @relation("ProjectCreator", fields: [createdById], references: [id])
  startDate    DateTime?
  dueDate      DateTime?
  // When somebody last posted a progress update here. Denormalised on purpose:
  // "nothing has been reported on this for three weeks" is the single most
  // useful alert in the system, and it must not cost a join per project.
  lastUpdateAt DateTime?
  // Soft delete. Nothing is ever removed outright, so history survives.
  archivedAt   DateTime?
  archivedById String?       @db.Char(36)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  members     ProjectMember[]
  tasks       Task[]
  meetings    Meeting[]
  comments    ProjectComment[]
  attachments Attachment[]
  activities  ActivityLog[]

  @@index([officeId])
  @@index([status])
  @@index([archivedAt])
  @@index([priority])
  @@index([dueDate])
}

model ProjectMember {
  id         String      @id @default(uuid()) @db.Char(36)
  projectId  String      @db.Char(36)
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String      @db.Char(36)
  user       User        @relation("ProjectMembership", fields: [userId], references: [id], onDelete: Cascade)
  role       ProjectRole @default(MEMBER)
  addedById  String?     @db.Char(36)
  addedAt    DateTime    @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model Task {
  id              String       @id @default(uuid()) @db.Char(36)
  title           String
  description     String?      @db.Text
  status          TaskStatus   @default(INITIATED)
  priority        TaskPriority @default(NORMAL)
  // Two offices, not one. The owning office stays accountable for the outcome
  // for the life of the work item; the executing office is whoever is actually
  // doing it, which changes when another office accepts an inter-office
  // request. One work item crosses the boundary; it is never duplicated.
  owningOfficeId    String?    @db.Char(36)
  owningOffice      Office?    @relation("TaskOwningOffice", fields: [owningOfficeId], references: [id])
  executingOfficeId String?    @db.Char(36)
  executingOffice   Office?    @relation("TaskExecutingOffice", fields: [executingOfficeId], references: [id])
  projectId       String?      @db.Char(36)
  project         Project?     @relation(fields: [projectId], references: [id])
  primaryLeadId   String?      @db.Char(36)
  primaryLead     User?        @relation("TaskPrimary", fields: [primaryLeadId], references: [id])
  secondaryLeadId String?      @db.Char(36)
  secondaryLead   User?        @relation("TaskSecondary", fields: [secondaryLeadId], references: [id])
  currentlyWithId String?      @db.Char(36)
  currentlyWith   User?        @relation("TaskHolder", fields: [currentlyWithId], references: [id])
  departmentId    String?      @db.Char(36)
  department      Department?  @relation("TaskDept", fields: [departmentId], references: [id])
  createdById     String?      @db.Char(36)
  createdBy       User?        @relation("TaskCreator", fields: [createdById], references: [id])
  assignedDate    DateTime?
  dueDate         DateTime?
  pctComplete     Int?
  // Last time somebody reported progress (not merely edited a field). Drives
  // the "no update in N days" alert without a join per row.
  lastUpdateAt    DateTime?
  // Soft delete, so a removed work item stays in the audit trail.
  archivedAt      DateTime?
  archivedById    String?      @db.Char(36)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  requests    TaskRequest[]
  comments    TaskComment[]
  attachments Attachment[]
  meetings    Meeting[]
  activities  ActivityLog[]

  @@index([primaryLeadId])
  @@index([projectId])
  @@index([owningOfficeId])
  @@index([executingOfficeId])
  @@index([archivedAt])
  @@index([dueDate])
  @@index([status])
  @@index([departmentId])
  @@index([priority])
  @@index([lastUpdateAt])
}

// ---------- assign / request work ----------
model TaskRequest {
  id               String       @id @default(uuid()) @db.Char(36)
  taskId           String       @db.Char(36)
  task             Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromId           String?      @db.Char(36)
  from             User?        @relation("ReqFrom", fields: [fromId], references: [id])
  toId             String?      @db.Char(36)
  to               User?        @relation("ReqTo", fields: [toId], references: [id])
  toDepartmentId   String?      @db.Char(36)
  toDepartment     Department?  @relation("ReqDept", fields: [toDepartmentId], references: [id])
  toOfficeId       String?      @db.Char(36)
  toOffice         Office?      @relation("ReqOffice", fields: [toOfficeId], references: [id])
  scope            RequestScope @default(USER)
  message          String?      @db.Text
  state            RequestState @default(PENDING_ACCEPTANCE)
  requiresApproval Boolean      @default(false)
  approvedById     String?      @db.Char(36)
  approvedBy       User?        @relation("ReqApprover", fields: [approvedById], references: [id])
  resolvedAt       DateTime?
  createdAt        DateTime     @default(now())

  @@index([taskId])
  @@index([toId])
  @@index([toDepartmentId])
  @@index([toOfficeId])
  @@index([state])
}

// ---------- discussion: remarks, directions and progress updates ----------
/// One post on the thread of a work item. Anyone who can see the work item can
/// post here; that is the point. A post is never destroyed, only tombstoned,
/// because a discussion with holes in it is not an audit trail.
model TaskComment {
  id         String      @id @default(uuid()) @db.Char(36)
  taskId     String      @db.Char(36)
  task       Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId   String?     @db.Char(36)
  author     User?       @relation(fields: [authorId], references: [id])
  /// The post the author held when they wrote this, captured at write time.
  /// Designations change; what a remark was signed as must not.
  authorRole String?
  kind       CommentKind @default(REMARK)
  body       String      @db.Text
  /// For a STATUS_UPDATE: { statusFrom, statusTo, pctFrom, pctTo }. Frozen at
  /// write time so the thread still reads correctly after later edits.
  meta       Json?
  /// Replies hang off their parent, so a long thread stays followable.
  parentId   String?     @db.Char(36)
  parent     TaskComment?  @relation("TaskCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    TaskComment[] @relation("TaskCommentThread")
  /// Pinned posts surface at the top: the current direction, the live blocker.
  isPinned   Boolean     @default(false)
  editedAt   DateTime?
  deletedAt  DateTime?
  createdAt  DateTime    @default(now())

  attachments Attachment[]

  @@index([taskId])
  @@index([parentId])
  @@index([authorId])
  @@index([kind])
}

/// The same thread, at project level: programme-wide discussion and reporting
/// that does not belong to any one work item.
model ProjectComment {
  id         String      @id @default(uuid()) @db.Char(36)
  projectId  String      @db.Char(36)
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId   String?     @db.Char(36)
  author     User?       @relation(fields: [authorId], references: [id])
  authorRole String?
  kind       CommentKind @default(REMARK)
  body       String      @db.Text
  meta       Json?
  parentId   String?     @db.Char(36)
  parent     ProjectComment?  @relation("ProjectCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    ProjectComment[] @relation("ProjectCommentThread")
  isPinned   Boolean     @default(false)
  editedAt   DateTime?
  deletedAt  DateTime?
  createdAt  DateTime    @default(now())

  attachments Attachment[]

  @@index([projectId])
  @@index([parentId])
  @@index([authorId])
  @@index([kind])
}

// ---------- attachments (files on server disk / cloud) ----------
/// A file. It hangs off exactly one thing: a work item, a project, or a single
/// post on either thread. Keeping one table rather than three means one upload
/// path, one download path and one permission check to get right.
model Attachment {
  id           String   @id @default(uuid()) @db.Char(36)
  taskId       String?  @db.Char(36)
  task         Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId    String?  @db.Char(36)
  project      Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Set when the file was attached to a specific post rather than to the
  /// work item as a whole.
  taskCommentId    String?      @db.Char(36)
  taskComment      TaskComment? @relation(fields: [taskCommentId], references: [id], onDelete: Cascade)
  projectCommentId String?         @db.Char(36)
  projectComment   ProjectComment? @relation(fields: [projectCommentId], references: [id], onDelete: Cascade)
  storagePath  String
  fileName     String
  /// Size in bytes and the declared MIME type, both recorded at upload so a
  /// file list can be rendered without touching the disk.
  size         Int?
  mimeType     String?
  uploadedById String?  @db.Char(36)
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([taskId])
  @@index([projectId])
  @@index([taskCommentId])
  @@index([projectCommentId])
}

// ---------- meetings ----------
model Meeting {
  id          String      @id @default(uuid()) @db.Char(36)
  title       String
  agenda      String?     @db.Text
  projectId   String?     @db.Char(36)
  project     Project?    @relation(fields: [projectId], references: [id])
  taskId      String?     @db.Char(36)
  task        Task?       @relation(fields: [taskId], references: [id])
  startsAt    DateTime
  /// Optional finish time. Without it the calendar has to guess, and a two-hour
  /// review renders as a point in time.
  endsAt      DateTime?
  mode        MeetingMode @default(PHYSICAL)
  location    String?
  /// Minutes of the meeting, written up afterwards.
  minutes     String?     @db.Text
  createdById String?     @db.Char(36)
  createdBy   User?       @relation("MeetingCreator", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())

  participants MeetingParticipant[]

  @@index([projectId])
  @@index([taskId])
  @@index([startsAt])
}

model MeetingParticipant {
  meetingId String  @db.Char(36)
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String  @db.Char(36)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
  @@index([userId])
}

// ---------- notifications (email digest reads from here) ----------
model Notification {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @db.Char(36)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  payload   Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

// ---------- activity log (audit trail) ----------
model ActivityLog {
  id        String   @id @default(uuid()) @db.Char(36)
  taskId    String?  @db.Char(36)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// Project-level events (team changes, project status, project files) so a
  /// programme has its own timeline and not just the union of its work items'.
  projectId String?  @db.Char(36)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId   String?  @db.Char(36)
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  detail    Json?
  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([projectId])
  @@index([createdAt])
}
